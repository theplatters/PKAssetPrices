  title = {Monetary {{Policy}} with {{Endogenous Money}} and {{Liquidity Preference}}: {{A Nondualistic Treatment}}},
  shorttitle = {Monetary {{Policy}} with {{Endogenous Money}} and {{Liquidity Preference}}},
  author = {Chick, Victoria and Dow, Sheila},
